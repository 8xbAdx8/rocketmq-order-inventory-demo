<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 父工程统一管理常用依赖和 Maven 插件的版本。
        后续添加 Spring Boot 官方 Starter 时，通常不需要逐个填写版本号。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Maven 项目坐标：用于唯一标识当前工程。 -->
    <groupId>com.example</groupId>
    <artifactId>rocketmq-learning</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rocketmq-learning</name>
    <description>Spring Boot and RocketMQ learning project</description>

    <properties>
        <!-- Java 源码、资源过滤和构建输出统一使用 UTF-8，避免 YAML 中文注释被转码损坏。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
            告诉 Maven 使用 Java 17 编译项目。
            本机已经安装 JDK 17，因此这里与开发环境保持一致。
        -->
        <java.version>17</java.version>

        <!--
            RocketMQ Spring 的版本由属性集中管理。
            它不属于 Spring Boot 官方依赖管理范围，因此需要显式指定版本。
        -->
        <rocketmq-spring.version>2.3.5</rocketmq-spring.version>
    </properties>

    <dependencies>
        <!--
            最基础的 Spring Boot Starter。
            它提供 Spring 容器和基础日志能力，但不会自动引入 Web 或 MySQL。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Web Starter 提供 Spring MVC、内嵌 Tomcat 和 JSON 序列化能力，
            让订单用例可以通过 HTTP 接口被 Postman、前端或自动化测试调用。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Bean Validation 用声明式注解校验 HTTP 请求参数。
            参数不合法时在进入业务 Service 前即返回 400，避免无效消息进入 RocketMQ。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring JDBC 提供 JdbcTemplate、数据库连接池自动配置和事务管理能力。
            本项目暂不引入 JPA：显式编写 SQL 更有利于学习库存条件扣减和事务边界。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            MySQL 官方 JDBC 驱动，仅在运行时连接数据库时使用。
            版本由 Spring Boot 统一管理，避免手工选择不兼容版本。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway 用版本化 SQL 管理数据库结构。
            flyway-core 提供迁移引擎，flyway-mysql 提供 MySQL 8 的数据库支持。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!--
            Apache RocketMQ 提供的 Spring Boot Starter。

            引入后，Spring Boot 可以根据 rocketmq.* 配置自动创建发送消息所需的组件，
            并识别 @RocketMQMessageListener 消费者监听器。后续主要使用
            RocketMQTemplate 和监听注解，不直接操作底层 DefaultMQProducer API。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq-spring.version}</version>
        </dependency>

        <!--
            Spring Boot 测试 Starter，只在测试阶段使用，不会打进生产运行依赖。
            后续可使用 JUnit、Spring Test 等工具验证工程。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                让 Maven 能够运行 Spring Boot 应用，并将项目打包成可执行 JAR。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
